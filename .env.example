# Copy thành .env rồi điền giá trị. Đây là chỗ thay cho AWS Secrets Manager
# (secret content-platform-dev/app-secrets của bản cloud).
#
#   cp .env.example .env
#
# Sinh nhanh hai khoá tự tạo:
#   openssl rand -hex 32    -> APP_API_KEY
#   openssl rand -hex 32    -> N8N_ENCRYPTION_KEY
# File .env KHÔNG được commit (đã có trong .gitignore).

# ─── Chung ──────────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
# uid/gid của bạn trên host, để container ghi được vào ./data/media (`id -u`, `id -g`).
HOST_UID=1000
HOST_GID=1000

# ─── Postgres (pgvector) ────────────────────────────────────────────────────
POSTGRES_USER=contenthub
POSTGRES_PASSWORD=
POSTGRES_DB=contenthub
# Cổng trên host; đổi nếu máy đã có Postgres chạy ở 5432.
POSTGRES_PORT=5432

# ─── pgAdmin (http://localhost:5050) ────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050

# ─── n8n (http://localhost:5678) ────────────────────────────────────────────
# Nên ghim một phiên bản cụ thể (vd. 1.117.2) thay vì latest để nâng cấp có kiểm soát.
N8N_IMAGE_TAG=latest
N8N_HOST=localhost
N8N_PORT=5678
# Khoá mã hoá credential của n8n. ĐỔI LÀ MẤT credential đã lưu -> đặt một lần rồi giữ nguyên.
N8N_ENCRYPTION_KEY=
# Trần timeout cho một execution (giây). Luồng NBA render nhiều reel nối tiếp nên để cao.
N8N_EXECUTIONS_TIMEOUT_MAX=28800
# Giữ lịch sử execution bao nhiêu giờ (336 = 14 ngày).
N8N_EXECUTIONS_DATA_MAX_AGE=336

# ─── Khoá nội bộ: n8n -> các service (header X-Api-Key) ─────────────────────
# Thay cho CRAWL_API_KEY của bản cloud.
APP_API_KEY=

# ─── OpenAI (chọn clip + viết script) ───────────────────────────────────────
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o

# ─── ElevenLabs (giọng đọc + nhạc nền) ──────────────────────────────────────
ELEVENLABS_API_KEY=
# Voice id dùng cho kênh NBA. Node Voice của n8n để trống voice_id thì service lấy giá trị này.
ELEVENLABS_VOICE_ID=

# ─── Storyteller (nguồn clip NBA) ───────────────────────────────────────────
# Service nba-content gọi API Storyteller (mode fetch_clips) nên khoá không nằm trong workflow.
STORYTELLER_API_KEY=

# ─── YouTube (OAuth app dùng chung + refresh token của từng kênh) ───────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Tên biến này phải khớp content.channels.credential_key của kênh nba-yt.
YOUTUBE_REFRESH_TOKEN_NBA=

# ─── Facebook (token System User, dùng chung cho các Page được gán) ─────────
# Tên biến này phải khớp content.channels.credential_key của kênh nba-fb.
FACEBOOK_TOKEN_SOURCE_ACCESS_TOKEN=

# ─── Media trên đĩa local (thay bucket S3) ──────────────────────────────────
# Thư mục trên host, mount vào /data/media của các service.
MEDIA_HOST_DIR=./data/media
# Tự xoá thư mục reel cũ hơn số ngày này (thay lifecycle rule 7 ngày của S3). 0 = không xoá.
MEDIA_RETENTION_DAYS=7
CLEANUP_INTERVAL_HOURS=6

# ─── Render (ffmpeg trên PC cá nhân) ────────────────────────────────────────
# Số video render song song. PC thường để 1 (ffmpeg đã dùng hết CPU).
RENDER_CONCURRENCY=1
# ultrafast | superfast | veryfast | faster | fast | medium | slow ...
FFMPEG_PRESET=medium
FFMPEG_CRF=20

# ─── Cổng debug của các service (gọi trực tiếp bằng curl) ───────────────────
NBA_CONTENT_PORT=8081
NBA_RENDER_PORT=8082
PUBLISH_MEDIA_PORT=8083
