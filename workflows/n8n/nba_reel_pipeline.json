      "parameters": {
        "jsCode": "const items = $input.all().map((i) => i.json);\nreturn [{ json: { reel_id: items[0].reel_id, results_json: JSON.stringify(items.map(({ reel_id, ...r }) => r)) } }];\n"
      },
      "id": "5e2622a6-964a-5902-baaa-40b6f06b82a7",
