    {
      "parameters": {
        "jsCode": "// Reached from the error output of a step (or a render that failed / ran out of time).\n// Only this clip is marked failed; the loop goes on with the next one.\nconst j = $json;\nconst e = j.error;\nlet reason;\nif (typeof e === 'string') reason = e;\nelse if (e && (e.message || e.description)) reason = [e.message, e.description].filter(Boolean).join(' - ');\nelse if (j.status === 'rendering') reason = 'render did not finish in time';\nelse reason = JSON.stringify(j).slice(0, 1000);\n// HTTP errors look like: 500 - \"{\\\"error\\\": \\\"script failed: ...\\\"}\" -> keep the inner message.\nconst inner = String(reason).replace(/\\\\\"/g, '\"').match(/\"error\":\\s*\"((?:[^\"\\\\]|\\\\.)*)\"/);\nif (inner) reason = inner[1];\nreturn { json: { reel_id: $('Loop Over Clips').item.json.reel_id, reason: String(reason).slice(0, 4000) } };\n",
        "mode": "runOnceForEachItem"
      },
