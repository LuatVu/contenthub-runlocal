    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Validates the channels and binds them (format 'reel') to this workflow on first run.\n-- Fails if another workflow already owns one of them: one workflow per channel and format.\nSELECT content.bind_channels($1::text[], 'reel', $2::text, $3::text) AS cfg;",
        "options": {
          "queryReplacement": "={{ [ $json.channel_codes, $workflow.id, $workflow.name ] }}"
        }
      },
      "id": "a5996664-83d6-570f-aaee-36d2366eb448",
      "name": "Bind Channels",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        500,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "ContentHub Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Effective run config: Set Parameters overridden by the channels' content_profile.\n// Endpoints, channel_codes and publish stay workflow-level.\nconst base = $('Set Parameters').first().json;\nconst cfg = $input.first().json.cfg;\nconst profile = cfg.profile || {};\nconst LOCKED = new Set(['channel_codes', 'publish', 'nba_url', 'publish_url']);\nconst out = { ...base };\nfor (const [k, v] of Object.entries(profile)) if (!LOCKED.has(k)) out[k] = v;\nout.topic = cfg.topic;\nout.channels = cfg.channels;\n// Same pairs as SUPPORTED in services/publish-media/app/main.py.\nconst bad = cfg.channels.filter((c) => !['facebook', 'youtube'].includes(c.platform));\nif (bad.length) {\n  throw new Error(`publishing reel to ${bad.map((c) => `${c.code} (${c.platform})`).join(', ')} is not implemented yet`);\n}\nreturn [{ json: out }];\n"
      },
