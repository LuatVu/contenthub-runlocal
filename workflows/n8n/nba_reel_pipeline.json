    {
      "parameters": {
        "jsCode": "// One entry per channel. YouTube is capped to the best `youtube_max_clips` clips per run\n// (Data API quota: an upload costs 1,600 of the default 10,000 daily units).\nconst p = $('Resolve Config').first().json;\nconst loop = $('Loop Over Clips').item.json;\nconst script = $('Generate Script').item.json.script;\nconst videoKey = $('Wait For Render').item.json.video_key;\nconst plans = p.channels.map((channel) => {\n  if (channel.platform === 'youtube' && loop.rank > Number(p.youtube_max_clips || 6)) {\n    return { channel: channel.code, reel_id: loop.reel_id, skip: true, reason: `YouTube cap: rank ${loop.rank} > ${p.youtube_max_clips}` };\n  }\n  return { channel: channel.code, reel_id: loop.reel_id, skip: false, body: {\n    mode: 'publish', format: 'reel', channel, video_key: videoKey, title: script.title,\n    description: script.description, tags: script.tags, publish_at: loop.publish_at, language: p.language || 'en',\n  } };\n});\nreturn { json: { plans } };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "5a445d9a-afd1-5869-9e8f-b47579483a36",
