        "operation": "executeQuery",
        "query": "SELECT COUNT(*) FILTER (WHERE status IN ('scheduled','published'))::int AS ok,\n       COUNT(*) FILTER (WHERE status = 'failed' OR error_message IS NOT NULL)::int AS problems,\n       COALESCE(string_agg(clip_id || ': ' || error_message, E'\\n') FILTER (WHERE error_message IS NOT NULL), '') AS errors\nFROM content_nba.reels WHERE id = ANY($1::uuid[]);",
