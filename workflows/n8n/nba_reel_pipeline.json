    {
      "parameters": {
        "jsCode": "// Pairs the publish response with its plan entry (reel + channel).\nconst plan = $('Split Plans').item.json;\nconst j = $json || {};\nconst base = { reel_id: plan.reel_id, channel: plan.channel };\nif ((j.status === 'scheduled' || j.status === 'published') && j.post_id) {\n  return { json: { ...base, status: j.status, post_id: String(j.post_id), url: j.url || null, scheduled_for: j.scheduled_for || null } };\n}\nlet error = j.error;\nif (error && typeof error !== 'string') error = [error.message, error.description].filter(Boolean).join(' - ');\nconst inner = String(error || '').replace(/\\\\\"/g, '\"').match(/\"error\":\\s*\"((?:[^\"\\\\]|\\\\.)*)\"/);\nif (inner) error = inner[1];\nreturn { json: { ...base, status: 'failed', error: String(error || 'publish failed').slice(0, 2000) } };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "ea58578d-791d-59fb-90f5-2e69e16cbca8",
      "name": "Tag Result",
