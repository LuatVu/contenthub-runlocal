    {
      "parameters": {
        "jsCode": "// One item per reel this run owns, each with a publish slot in US prime time.\n// `slots` lists HH:mm in slot_timezone, best slot first; rank 1 gets the first slot.\nconst p = $('Resolve Config').first().json;\nconst owned = ($input.first().json.result || []).slice().sort((a, b) => a.rank - b.rank);\nconst byClip = Object.fromEntries(($('Select Clips').first().json.selected || []).map((s) => [s.clip_id, s]));\nconst tz = p.slot_timezone || 'America/New_York';\nconst slots = (p.slots || []).map(String);\nif (!slots.length) throw new Error('slots must not be empty');\nconst earliest = DateTime.now().plus({ minutes: Number(p.min_lead_minutes || 30) });\nconst today = DateTime.now().setZone(tz).startOf('day');\nconst taken = new Set();\nreturn owned.map((o, i) => {\n  const [h, m] = slots[i % slots.length].split(':').map(Number);\n  let when = today.plus({ days: Math.floor(i / slots.length) }).set({ hour: h, minute: m });\n  while (when < earliest || taken.has(when.toMillis())) when = when.plus({ days: 1 });\n  taken.add(when.toMillis());\n  return { json: {\n    reel_id: o.reel_id, clip_id: o.clip_id, rank: o.rank,\n    publish_at: when.toUTC().toISO(), publish_local: when.toFormat(\"yyyy-LL-dd HH:mm ZZZZ\"),\n    clip: byClip[o.clip_id],\n  } };\n});\n"
      },
